PORT=3000
OPENROUTER_API_KEY=incolla-qui-la-tua-chiave
OPENROUTER_MODEL=openai/gpt-4o-mini
# Lascia vuoto se frontend e API usano la stessa origine.
# Se usi un frontend separato, inserisci le origini consentite separate da virgola.
CORS_ORIGIN=

# Backend FastAPI: copia in backend/.env se avvii uvicorn da backend/.
# URL base senza UUID, query o credenziali. Il backend aggiunge l'UUID.
COPERNICUS_WMS_ENDPOINT=https://sh.dataspace.copernicus.eu/ogc/wms
# UUID dell'istanza nella Configuration Utility di Sentinel Hub. Lascialo privato.
COPERNICUS_WMS_INSTANCE=
# Identificativo esatto di un layer RGB globale con dataMask come canale alpha.
COPERNICUS_WMS_LAYER=
